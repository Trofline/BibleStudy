<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BibleStudy for the iPhone: the whole program, built from the same sources as the desktop and Android programs (src/BibleStudy.App).
    There is no paid Apple developer account behind it: the build on GitHub makes an unsigned IPA, which SideStore signs on the phone
    with the person's own (free) Apple ID. What only a PC has (tray, second screen, installer, MCP server, Windows speech) is left out
    with #if MOBILE, as on Android.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BibleStudy.App</RootNamespace>
    <AssemblyName>BibleStudy.App</AssemblyName>
    <ApplicationId>de.trofline.biblestudy</ApplicationId>
    <ApplicationVersion>43</ApplicationVersion>
    <ApplicationDisplayVersion>1.9.24</ApplicationDisplayVersion>
    <Version>1.9.24</Version>
    <ApplicationTitle>BibleStudy</ApplicationTitle>
    <Product>BibleStudy</Product>
    <Authors>Trofline</Authors>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <!-- no signing here: SideStore signs the app on the phone -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <!-- only the .NET libraries are trimmed (to what the program uses); the program itself is kept whole, because it uses reflection (JSON, bindings) -->
    <MtouchLink>SdkOnly</MtouchLink>
    <DefineConstants>$(DefineConstants);MOBILE</DefineConstants>
    <!-- the shared sources warn about many things the desktop build already reports -->
    <NoWarn>$(NoWarn);CA1416;CA1422;CS0618;CS0067;CS0169;CS0414;CS0649;CA2200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="PDFtoImage" Version="5.2.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="..\BibleStudy.Core\BibleStudy.Core.csproj" />
  </ItemGroup>

  <!-- the program itself, shared with the desktop and Android -->
  <ItemGroup>
    <Compile Include="..\BibleStudy.App\**\*.cs" Exclude="..\BibleStudy.App\bin\**;..\BibleStudy.App\obj\**;..\BibleStudy.App\Program.cs;..\BibleStudy.App\UninstallWindow.cs" LinkBase="App" />
    <AvaloniaXaml Include="..\BibleStudy.App\**\*.axaml" Exclude="..\BibleStudy.App\bin\**;..\BibleStudy.App\obj\**" LinkBase="App" />
    <AvaloniaResource Include="..\BibleStudy.App\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/handbuch/*.md" LogicalName="Handbuch/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/handbook/*.md" LogicalName="Handbook/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the app icon as plain files (no asset catalog: its compiler needs a part of Xcode that is missing on the build machine) -->
  <ItemGroup>
    <!-- at the top of the app: iOS looks for CFBundleIconFiles only there -->
    <BundleResource Include="Icons/*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BibleStudy.Core.Loc" Static="true" />
    <Using Include="BibleStudy.Core.Loc" Alias="Loc" />
    <!-- the iOS implicit usings (Foundation, UIKit …) collide with the Avalonia names -->
    <Using Remove="Foundation" />
    <Using Remove="UIKit" />
    <Using Remove="CoreGraphics" />
    <Using Remove="ObjCRuntime" />
    <Using Remove="CoreFoundation" />
  </ItemGroup>
</Project>
