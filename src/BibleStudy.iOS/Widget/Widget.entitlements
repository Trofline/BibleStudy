<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The widget reads the file of the app from the folder of this group. SideStore registers the group with the Apple ID that signs the app. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.trofline.biblestudy</string>
	</array>
</dict>
</plist>
