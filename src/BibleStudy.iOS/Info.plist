	<string>BibleStudy records a spoken note on a verse only when you start a recording.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>BibleStudy uses the local network for the live Bible study and to sync your own devices.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_biblestudy-sync._tcp</string>
		<string>_http._tcp</string>
	</array>
