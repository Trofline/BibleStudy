<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Authors>Trofline</Authors>
    <Product>BibleStudy</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="BibleStudy.Core.Loc" Static="true" />
    <Using Include="BibleStudy.Core.Loc" Alias="Loc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Speech" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <ProjectReference Include="..\BibleStudy.Core\BibleStudy.Core.csproj" />
    <!-- The MCP server is built first and shipped next to the app (mcp\BibleStudy.Mcp.exe). -->
    <ProjectReference Include="..\BibleStudy.Mcp\BibleStudy.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyMcpServer" AfterTargets="Build">
    <ItemGroup>
      <McpFiles Include="..\BibleStudy.Mcp\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpFiles)" DestinationFiles="@(McpFiles->'$(OutDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
