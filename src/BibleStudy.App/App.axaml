<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BibleStudy.App.App"
             RequestedThemeVariant="Default">
    <!-- Design tokens per theme variant ("Default" follows the system). Direction: scholar's study — warm paper / ink, brass accent. -->

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#8A4F0F</Color>
            <Color x:Key="SystemAccentColorLight1">#A0651C</Color>
            <Color x:Key="SystemAccentColorLight2">#B87A30</Color>
            <Color x:Key="SystemAccentColorLight3">#CC9450</Color>
            <Color x:Key="SystemAccentColorDark1">#74410C</Color>
            <Color x:Key="SystemAccentColorDark2">#5E3409</Color>
            <Color x:Key="SystemAccentColorDark3">#482807</Color>
            <FontFamily x:Key="UiSerif">avares://BibleStudy.App/Assets/Fonts#Crimson Text, Cambria, Georgia, serif</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BsBackground" Color="#F6F1E6" />
                    <SolidColorBrush x:Key="BsSurface" Color="#FFFCF6" />
                    <SolidColorBrush x:Key="BsSurface2" Color="#EFE8D8" />
                    <SolidColorBrush x:Key="BsHover" Color="#E8DFCB" />
                    <SolidColorBrush x:Key="BsBorder" Color="#E2D9C5" />
                    <SolidColorBrush x:Key="BsText" Color="#24201A" />
                    <SolidColorBrush x:Key="BsMuted" Color="#6B6354" />
                    <SolidColorBrush x:Key="BsAccent" Color="#8A4F0F" />
                    <SolidColorBrush x:Key="BsAccentSoft" Color="#F0DFBF" />
                    <SolidColorBrush x:Key="BsVerseNumber" Color="#A0651C" />
                    <SolidColorBrush x:Key="BsJesus" Color="#A8281F" />
                    <SolidColorBrush x:Key="BsAccentFg" Color="#FFFCF6" />
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="#F0DFBF" />
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="#F0DFBF" />
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="#E8DFCB" />
                    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
                    <!-- Fluent control overrides -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#E8DFCB" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E8DFCB" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#6B6354" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#24201A" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#8A4F0F" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#8A4F0F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BsBackground" Color="#0F1216" />
                    <SolidColorBrush x:Key="BsSurface" Color="#161A20" />
                    <SolidColorBrush x:Key="BsSurface2" Color="#1F252D" />
                    <SolidColorBrush x:Key="BsHover" Color="#2A323D" />
                    <SolidColorBrush x:Key="BsBorder" Color="#262D37" />
                    <SolidColorBrush x:Key="BsText" Color="#ECE7DA" />
                    <SolidColorBrush x:Key="BsMuted" Color="#9AA2AD" />
                    <SolidColorBrush x:Key="BsAccent" Color="#E3B65F" />
                    <SolidColorBrush x:Key="BsAccentSoft" Color="#3A3120" />
                    <SolidColorBrush x:Key="BsVerseNumber" Color="#D9A94F" />
                    <SolidColorBrush x:Key="BsJesus" Color="#FF9A8F" />
                    <SolidColorBrush x:Key="BsAccentFg" Color="#161A20" />
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="#3A3120" />
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="#3A3120" />
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="#2A323D" />
                    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2A323D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2A323D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#9AA2AD" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#ECE7DA" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#E3B65F" />
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#E3B65F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Icon buttons -->
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsAccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccent}" />
        </Style>

        <!-- Pills (grouped controls in the top bar) -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource BsSurface2}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Rectangle.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{DynamicResource BsBorder}" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Default buttons: quiet, rounded, readable -->
        <Style Selector="Button:not(.tool):not(.pillbtn):not(.primary):not(.toolx):not(.picker):not(.caption):not(.rail):not(.seg):not(.ghost):not(.wtab)">
            <Setter Property="Background" Value="{DynamicResource BsSurface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BsBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button:not(.tool):not(.pillbtn):not(.primary):not(.toolx):not(.picker):not(.caption):not(.rail):not(.seg):not(.ghost):not(.wtab):pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BsBorder}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BsAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccentFg}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccentFg}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
<Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <!-- Window buttons of the custom title bar -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="60" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Pickers in the top bar (open a grid flyout instead of a scrolling list) -->
        <Style Selector="Button.picker">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.picker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="MaxWidth" Value="1000" />
            <Setter Property="MaxHeight" Value="900" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Labelled tool in the reading toolbar -->
        <Style Selector="Button.toolx, ToggleButton.toolx">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="Button.toolx:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolx:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="ToggleButton.toolx:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolx:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsAccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccent}" />
        </Style>

        <!-- Side panel navigation: rail (big sections) and segment pills (views inside a section) -->
        <Style Selector="TabControl#SideTabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.rail">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,9" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="Button.rail.active /template/ ContentPresenter#PART_ContentPresenter, Button.rail.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsAccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccent}" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource BsSurface2}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter, Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccentFg}" />
        </Style>

        <!-- Work tabs of the main window (like the tabs of the Windows Explorer) -->
        <Style Selector="Button.wtab">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="CornerRadius" Value="9,9,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="Button.wtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="Button.wtab.active /template/ ContentPresenter#PART_ContentPresenter, Button.wtab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>

        <!-- Labelled toggle in the reading toolbar -->
        <Style Selector="ToggleButton.pillbtn">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource BsSurface2}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="ToggleButton.pillbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BsText}" />
        </Style>
        <Style Selector="ToggleButton.pillbtn:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.pillbtn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BsAccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BsAccent}" />
        </Style>

        <!-- Cards, inputs -->
        <Style Selector="Border.card Border.pill">
            <Setter Property="Background" Value="{DynamicResource BsSurface}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BsSurface2}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="{DynamicResource BsBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <!-- writing area of a document: no frame, it is the page itself -->
        <Style Selector="TextBox.paper">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontFamily" Value="{DynamicResource UiSerif}" />
        </Style>
        <Style Selector="TextBox.paper:pointerover /template/ Border#PART_BorderElement, TextBox.paper:focus /template/ Border#PART_BorderElement, TextBox.paper:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- Text roles -->
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.6" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{DynamicResource UiSerif}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BsMuted}" />
        </Style>

        <!-- Side rail tabs -->
        <Style Selector="TabItem">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Lists -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <!-- Tiles on the start page -->
        <Style Selector="Border.tile:pointerover">
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <!-- Verse rows in the reader -->
        <Style Selector="Border.verse:pointerover">
            <Setter Property="Background" Value="{DynamicResource BsSurface2}" />
        </Style>

        <!-- Motion: soft press, hover and selection transitions (the window class "noanim" switches them off) -->
        <Style Selector="Button">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.95)" /></Style>
        <Style Selector="Button.rail:pointerover"><Setter Property="RenderTransform" Value="scale(1.06)" /></Style>
        <Style Selector="Border.tile">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tile:pointerover"><Setter Property="RenderTransform" Value="scale(1.025)" /></Style>
        <Style Selector="Border.verse">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.noanim Button, Window.noanim Border.tile, Window.noanim Border.verse">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
    </Application.Styles>
</Application>
