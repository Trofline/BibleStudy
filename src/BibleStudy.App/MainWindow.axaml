<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BibleStudy.App"
        x:Class="BibleStudy.App.MainWindow"
        Title="BibleStudy" Width="1280" Height="800" MinWidth="1180" MinHeight="560"
        Background="{DynamicResource BsBackground}" Foreground="{DynamicResource BsText}">
    <Window.Resources>
        <DataTemplate x:Key="EntryTpl" x:DataType="local:Entry">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" IsVisible="{Binding HasColor}" Background="{Binding ColorBrush}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource BsAccent}" TextWrapping="Wrap" />
                </StackPanel>
                <local:MarkedBlock Marked="{Binding Body}" IsVisible="{Binding HasBody}" TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar: where am I (navigation) -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Padding="16,0" Height="60" Background="{DynamicResource BsSurface}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource BsAccent}">
                        <local:Icon Data="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"
                                    IconSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    TextElement.Foreground="{DynamicResource BsSurface}" />
                    </Border>
                    <TextBlock Text="BibleStudy" Classes="h2" FontSize="21" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Classes="tool" ToolTip.Tip="Zurück zur vorherigen Stelle (Alt+←)">
                        <local:Icon Data="M19 12H5 M12 19l-7-7 7-7" />
                    </Button>
                    <Button x:Name="HomeBtn" Classes="tool" ToolTip.Tip="Startseite: alle Bücher und Kapitel (Alt+Pos1)">
                        <local:Icon Data="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="VaultTopBtn" Classes="ghost" Margin="0,0,6,0" ToolTip.Tip="Aktiver Vault (deine Mappe mit Markierungen, Notizen, Dokumenten). Klicken zum Wechseln.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <local:Icon Data="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 7.9 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2z" IconSize="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="VaultTopText" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeBtn" Classes="tool" ToolTip.Tip="Hell / Dunkel / System wechseln (Strg+T)">
                        <local:Icon Data="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z" />
                    </Button>
                    <ToggleButton x:Name="PanelBtn" Classes="tool" IsChecked="True" ToolTip.Tip="Seitenleiste ein- und ausblenden (Strg+B); Rand ziehen ändert die Breite">
                        <local:Icon Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M15 3v18" />
                    </ToggleButton>
                </StackPanel>
                <Border DockPanel.Dock="Right" Classes="pill" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Bibelstelle öffnen (Joh 3,16) oder suchen (Strg+K)">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <local:Icon Data="M13 2L3 14h9l-1 8 10-12h-9z" IconSize="16" VerticalAlignment="Center" Opacity="0.7" />
                        <TextBox x:Name="QuickJumpBox" Width="190" MinHeight="32" Watermark="Gehe zu … (Strg+K)" BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="pill">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="LanguageBox" Width="105" PlaceholderText="Sprache" />
                            <Rectangle Classes="sep" />
                            <ComboBox x:Name="TranslationBox" Width="205" PlaceholderText="Übersetzung" />
                        </StackPanel>
                    </Border>
                    <Border Classes="pill">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="BookBox" Width="125" PlaceholderText="Buch" />
                            <Rectangle Classes="sep" />
                            <Button x:Name="PrevBtn" Classes="tool" Width="32" Height="32" ToolTip.Tip="Voriges Kapitel (Strg+←)">
                                <local:Icon Data="M15 18l-6-6 6-6" />
                            </Button>
                            <NumericUpDown x:Name="ChapterBox" Width="52" Minimum="1" Value="1" FormatString="0" ShowButtonSpinner="False"
                                           Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" MinHeight="32" />
                            <Button x:Name="NextBtn" Classes="tool" Width="32" Height="32" ToolTip.Tip="Nächstes Kapitel (Strg+→)">
                                <local:Icon Data="M9 18l6-6-6-6" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Reading toolbar: what can I do with this chapter (labelled, so nothing has to be guessed) -->
        <Border x:Name="ReadBar" DockPanel.Dock="Top" Padding="16,7" Background="{DynamicResource BsBackground}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <ToggleButton x:Name="ReadBtn" DockPanel.Dock="Left" Classes="pillbtn" VerticalAlignment="Center" ToolTip.Tip="Dieses Kapitel als gelesen markieren (Strg+R)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <local:Icon Data="M20 6L9 17l-5-5" IconSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Gelesen" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="pill"><StackPanel Orientation="Horizontal">
                        <Button x:Name="FontMinusBtn" Classes="tool" Width="32" Content="A−" FontSize="13" FontWeight="SemiBold" ToolTip.Tip="Schrift kleiner (Strg+−)" />
                        <Button x:Name="FontPlusBtn" Classes="tool" Width="32" Content="A+" FontSize="15" FontWeight="SemiBold" ToolTip.Tip="Schrift größer (Strg++)" />
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border Classes="pill"><StackPanel Orientation="Horizontal">
                        <Button x:Name="ViewBtn" Classes="toolx" ToolTip.Tip="Querverweise im Text, Graph neben dem Text">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0z" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Ansicht" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="GraphBtn" Classes="toolx" ToolTip.Tip="Querverweis-Graph (Netzwerk und Bogen)">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="M5 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M15 5a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M15 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M8.7 11l6.6-4.9 M8.7 13l6.6 4.9" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Graph" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="MapBtn" Classes="toolx" ToolTip.Tip="Karte: Orte des Kapitels oder Buches">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z M9 10a3 3 0 1 0 6 0a3 3 0 1 0-6 0z" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Karte" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="ParallelBtn" Classes="toolx" ToolTip.Tip="Weitere Übersetzung als Spalte daneben (max. 3)">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M12 3v18" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Parallel" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel></Border>
                    <Border Classes="pill"><StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="StudyBtn" Classes="toolx" ToolTip.Tip="Wortstudie: Wörter mit Strong-Nummer antippen">
                            <StackPanel Orientation="Horizontal" Spacing="9"><local:Icon Data="m5 8 6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 m22 22-5-10-5 10 M14 18h6" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Wortstudie" VerticalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="SpeakBtn" Classes="toolx" ToolTip.Tip="Vorlesen: angeklickten Vers oder das ganze Kapitel">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="M11 5L6 9H2v6h4l5 4z M15.5 8.5a5 5 0 0 1 0 7 M19 5a10 10 0 0 1 0 14" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Vorlesen" VerticalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                    </StackPanel></Border>
                    <Border Classes="pill"><StackPanel Orientation="Horizontal">
                        <Button x:Name="MarkBtn" Classes="toolx" ToolTip.Tip="Markierten Text oder Vers einfärben">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="m9 11-6 6v3h9l3-3 M22 12l-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Markieren" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button x:Name="BookmarkBtn" Classes="toolx" ToolTip.Tip="Ganzen Vers speichern / entfernen (Strg+D)">
                            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Data="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" IconSize="17" VerticalAlignment="Center" /><TextBlock Text="Merken" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel></Border>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- Extra translation columns -->
        <WrapPanel x:Name="ParallelBar" DockPanel.Dock="Top" IsVisible="False" Background="{DynamicResource BsSurface}" />

        <!-- Footer: license information of the shown translations -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" Height="32" Background="{DynamicResource BsSurface}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #StatusText.Text}" />
        </Border>

        <!-- Side panel with icon rail -->
        <Border x:Name="SidePanel" DockPanel.Dock="Right" Width="430" Background="{DynamicResource BsSurface}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="76" Background="{DynamicResource BsBackground}" BorderBrush="{DynamicResource BsBorder}" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="Rail" Margin="6,10" Spacing="4" />
                </Border>
                <StackPanel x:Name="SubNav" DockPanel.Dock="Top" Margin="14,12,12,0" Spacing="6">
                    <WrapPanel x:Name="SubPills" />
                    <TextBlock x:Name="SubHint" Classes="caption" TextWrapping="Wrap" MinHeight="32" />
                </StackPanel>
            <TabControl x:Name="SideTabs" TabStripPlacement="Left">
                <TabItem ToolTip.Tip="Suche">
                    <TabItem.Header><local:Icon Data="M3 11a8 8 0 1 0 16 0a8 8 0 1 0-16 0z M21 21l-4.3-4.3" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="SearchBox" Watermark="Wort, „Wendung“, L=Grundform, G3056, Joh 3,16 …" />
                                <Button x:Name="SearchGoBtn" Grid.Column="1" Classes="tool" Margin="6,0,0,0" ToolTip.Tip="Suchen (Enter)">
                                    <local:Icon Data="M3 11a8 8 0 1 0 16 0a8 8 0 1 0-16 0z M21 21l-4.3-4.3" />
                                </Button>
                            </Grid>
                            <WrapPanel>
                                <Border Classes="pill" Margin="0,0,8,4">
                                    <ComboBox x:Name="SearchScopeBox" Width="170" SelectedIndex="0" />
                                </Border>
                                <CheckBox x:Name="SearchExactCheck" Content="Ganze Wörter" Margin="0,0,8,4" ToolTip.Tip="Sonst finden Wortanfänge auch Endungen (lieb → liebe, lieben)" />
                                <ToggleButton x:Name="SearchHelpBtn" Classes="pillbtn" Margin="0,0,0,4" Content="Suchhilfe" FontSize="12.5" ToolTip.Tip="Alle Suchmöglichkeiten mit Beispielen" />
                            </WrapPanel>
                            <Border x:Name="SearchHelp" IsVisible="False" Classes="card">
                                <StackPanel x:Name="SearchHelpList" Spacing="6" />
                            </Border>
                            <WrapPanel x:Name="SearchHistoryPanel" />
                            <TextBlock x:Name="SearchInfo" Classes="caption" TextWrapping="Wrap" />
                            <WrapPanel x:Name="SearchBooksPanel" />
                            <Button x:Name="SearchQueueBtn" IsVisible="False" Content="Alle Treffer zur Leseliste" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ListBox x:Name="SearchList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Sammlung: Markierungen, Ordner, Tags">
                    <TabItem.Header><local:Icon Data="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 7.9 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2z" /></TabItem.Header>
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,14,12,12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto,Auto" Margin="0,0,0,8">
                            <Border Classes="pill" Margin="0,0,6,0"><ComboBox x:Name="FolderFilterBox" HorizontalAlignment="Stretch" /></Border>
                            <Border Classes="pill" Grid.Column="1" Margin="0,0,6,0"><ComboBox x:Name="TagFilterBox" HorizontalAlignment="Stretch" /></Border>
                            <ToggleButton x:Name="MarksDetailBtn" Grid.Column="2" Classes="tool" IsChecked="True" Margin="0,0,2,0" ToolTip.Tip="Verstexte und Notizen anzeigen oder nur die Stellen (Überblick)">
                                <TextBlock Text="Aa" FontWeight="SemiBold" FontSize="14" />
                            </ToggleButton>
                            <Button x:Name="MarksMoreBtn" Grid.Column="3" Classes="tool" ToolTip.Tip="Alle auf-/zuklappen, neuer Ordner, Ordner löschen">
                                <local:Icon Data="M5 12a1 1 0 1 0 2 0a1 1 0 1 0-2 0z M11 12a1 1 0 1 0 2 0a1 1 0 1 0-2 0z M17 12a1 1 0 1 0 2 0a1 1 0 1 0-2 0z" IconSize="18" />
                            </Button>
                            <Button x:Name="DeleteFolderBtn" IsVisible="False" Width="0" Height="0" />
                        </Grid>
                        <TextBox x:Name="NewFolderBox" Grid.Row="1" IsVisible="False" Watermark="Name des neuen Ordners, Enter zum Anlegen" Margin="0,0,0,8" />
                        <TextBlock x:Name="MarksEmpty" Grid.Row="3" Classes="caption" TextWrapping="Wrap" IsVisible="False" Margin="2,8" Text="Noch keine Markierungen. Wähle im Text ein Wort oder einen Vers und klicke oben auf „Markieren“ (Farbe wählen) oder „Merken“." />
                        <ListBox x:Name="MarksList" Grid.Row="3" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <Border x:Name="MarkEditor" Grid.Row="4" IsVisible="False" Margin="0,8,0,0" Padding="10" CornerRadius="12" Background="{DynamicResource BsSurface2}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="MarkEditTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <WrapPanel x:Name="EditSwatches" />
                                <TextBox x:Name="MarkNoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" Watermark="Notiz zu dieser Markierung" />
                                <TextBox x:Name="MarkTagsBox" Watermark="Tags, mit Komma getrennt" />
                                <Border Classes="pill"><ComboBox x:Name="MarkFolderBox" HorizontalAlignment="Stretch" /></Border>
                                <WrapPanel>
                                    <Button x:Name="MarkSaveBtn" Content="Speichern" Classes="primary" Margin="0,0,6,0" />
                                    <Button x:Name="MarkQueueBtn" Content="Zur Leseliste" Margin="0,0,6,0" />
                                    <Button x:Name="MarkDeleteBtn" Content="Löschen" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem ToolTip.Tip="Notizen">
                    <TabItem.Header><local:Icon Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBlock x:Name="NoteTarget" Classes="caption" Text="Vers anklicken, um eine Notiz zu schreiben" TextWrapping="Wrap" />
                            <TextBox x:Name="NoteEditor" AcceptsReturn="True" TextWrapping="Wrap" Height="120" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="NoteSaveBtn" Content="Speichern" Classes="primary" />
                                <Button x:Name="NoteDeleteBtn" Content="Löschen" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="NotesEmpty" DockPanel.Dock="Top" Classes="caption" TextWrapping="Wrap" IsVisible="False" Margin="2,8" Text="Noch keine Notizen. Klicke im Text einen Vers an, schreibe oben deine Notiz und speichere sie." />
                        <ListBox x:Name="NoteList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Wortstudie">
                    <TabItem.Header><local:Icon Data="m5 8 6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 m22 22-5-10-5 10 M14 18h6" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <ScrollViewer><StackPanel x:Name="StudyPanel" Spacing="10" Margin="0,0,8,0" /></ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Querverweise">
                    <TabItem.Header><local:Icon Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                            <Button x:Name="XrefQueueBtn" Content="Alle zur Leseliste" HorizontalAlignment="Left" ToolTip.Tip="Die gezeigten Querverweise nacheinander abarbeiten" />
                            <TextBlock x:Name="XrefTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="Vers anklicken, um Querverweise zu sehen" />
                            <TextBlock Classes="caption" Text="Quelle: OpenBible.info, CC BY 4.0" />
                        </StackPanel>
                        <ListBox x:Name="XrefList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Konkordanz">
                    <TabItem.Header><local:Icon Data="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                            <TextBlock x:Name="ConcTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="In der Wortstudie „Alle Vorkommen“ wählen" />
                            <TextBlock x:Name="ConcInfo" Classes="caption" TextWrapping="Wrap" />
                            <WrapPanel x:Name="ConcForms" Margin="0,4,0,0" />
                            <WrapPanel x:Name="ConcBooks" />
                        </StackPanel>
                        <ListBox x:Name="ConcList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Leseliste">
                    <TabItem.Header><local:Icon Data="M10 12h11 M10 18h11 M10 6h11 M4 10h2 M4 6h1v4 M6 18H4c0-1 2-2 2-3s-1-1.5-2-1" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <TextBlock x:Name="QueueInfo" Classes="caption" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button x:Name="QueueNextBtn" Content="Nächster ▶" Classes="primary" Margin="0,0,6,6" ToolTip.Tip="Springt zum ersten Eintrag und nimmt ihn von der Leseliste" />
                                <Button x:Name="QueueAddBtn" Content="Vers hinzufügen" Margin="0,0,6,6" />
                                <Button x:Name="QueueRemoveBtn" Content="Entfernen" Margin="0,0,6,6" />
                                <Button x:Name="QueueClearBtn" Content="Leeren" Margin="0,0,6,6" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="QueueList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="To-Do-Liste">
                    <TabItem.Header><local:Icon Data="M21 10.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.5 m9 11 3 3L22 4" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBox x:Name="TodoBox" Watermark="Neue Aufgabe, Enter zum Hinzufügen" />
                            <CheckBox x:Name="TodoVerseCheck" Content="Angeklickten Vers anhängen" />
                        </StackPanel>
                        <ScrollViewer><StackPanel x:Name="TodoPanel" Spacing="4" Margin="0,0,8,0" /></ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Grundtext: Hebräisch / Griechisch, Wort für Wort">
                    <TabItem.Header><local:Icon Data="M4 7V4h16v3 M9 20h6 M12 4v16" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <TextBlock x:Name="GrundtextInfo" Classes="caption" TextWrapping="Wrap" Text="Vers anklicken, um das Original Wort für Wort zu sehen." />
                            <Button x:Name="GrundtextCheckBtn" Content="Übersetzung mit Claude prüfen" HorizontalAlignment="Left" IsVisible="False" />
                        </StackPanel>
                        <ScrollViewer>
                            <StackPanel Spacing="10" Margin="0,0,8,0">
                                <WrapPanel x:Name="GrundtextPanel" />
                                <StackPanel x:Name="GrundtextDetail" Spacing="8" />
                                <TextBlock x:Name="GrundtextSource" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Strong-Nummern suchen">
                    <TabItem.Header><local:Icon Data="M4 9h16 M4 15h16 M10 3L8 21 M16 3l-2 18" /></TabItem.Header>
                    <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,12,12">
                        <StackPanel Spacing="8" Margin="0,0,0,8">
                            <TextBox x:Name="StrongSearchBox" Watermark="G3056, H1, λόγος, agape, love …  (Enter)" />
                            <TextBlock x:Name="StrongInfo" Classes="caption" TextWrapping="Wrap" Text="Nummer, Grundtextwort, Umschrift oder englische Bedeutung. Akzente sind egal." />
                        </StackPanel>
                        <ListBox x:Name="StrongList" Grid.Row="1" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <ScrollViewer Grid.Row="2" MaxHeight="300" Margin="0,8,0,0"><StackPanel x:Name="StrongDetail" Spacing="8" /></ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem ToolTip.Tip="Wissen: Notizen, Dokumente, Verknüpfungen">
                    <TabItem.Header><local:Icon Data="M4 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4z M8 3v18 M12 8h4 M12 12h4" /></TabItem.Header>
                    <Grid>
                        <DockPanel x:Name="DocListPanel" Margin="16,14,12,12">
                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                                <TextBox x:Name="DocSearchBox" Watermark="Dokumente durchsuchen (Titel, Text, Tags)" />
                                <WrapPanel>
                                    <Button x:Name="DocNewBtn" Content="Neue Notiz" Classes="primary" Margin="0,0,6,6" />
                                    <Button x:Name="DocFromVerseBtn" Content="Aus Vers" Margin="0,0,6,6" ToolTip.Tip="Neue Notiz zum angeklickten Vers, mit dem Verstext" />
                                    <Button x:Name="DocFileBtn" Content="Datei verknüpfen …" Margin="0,0,6,6" />
                                    <Button x:Name="DocGraphBtn" Content="Wissensgraph" Margin="0,0,6,6" />
                                </WrapPanel>
                                <Border Classes="pill" HorizontalAlignment="Left">
                                    <ComboBox x:Name="DocFilterBox" Width="240" SelectedIndex="0">
                                        <ComboBoxItem Content="Alle Dokumente" />
                                        <ComboBoxItem Content="Vorlagen" />
                                        <ComboBoxItem Content="Erwähnen den angeklickten Vers" />
                                    </ComboBox>
                                </Border>
                                <WrapPanel x:Name="DocTagChips" />
                                <TextBlock x:Name="DocInfo" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox x:Name="DocList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                        <ScrollViewer x:Name="DocEditorPanel" IsVisible="False" Margin="16,14,4,12">
                            <StackPanel Spacing="8" Margin="0,0,12,0">
                                <Button x:Name="DocBackBtn" Content="← Liste" HorizontalAlignment="Left" />
                                <TextBox x:Name="DocTitleBox" Watermark="Titel" FontSize="18" />
                                <WrapPanel>
                                    <Button x:Name="DocInsertVerseBtn" Content="＋ Vers einfügen" Margin="0,0,6,4" ToolTip.Tip="Fügt den angeklickten Vers als Zitat an der Schreibmarke ein" />
                                    <Button x:Name="DocInsertLinkBtn" Content="＋ Dokument verlinken" Margin="0,0,6,4" ToolTip.Tip="Fügt einen [[Link]] auf ein anderes Dokument ein" />
                                </WrapPanel>
                                <TextBox x:Name="DocBodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" Watermark="Text. Verse wie „Joh 3,16“ werden zu Links, [[Titel]] verlinkt ein anderes Dokument." />
                                <TextBox x:Name="DocTagsBox" Watermark="Tags, mit Komma getrennt" />
                                <CheckBox x:Name="DocTemplateCheck" Content="Als Vorlage verwenden" />
                                <TextBlock x:Name="DocPathText" Classes="caption" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button x:Name="DocSaveBtn" Content="Speichern" Classes="primary" Margin="0,0,6,6" />
                                    <Button x:Name="DocOpenFileBtn" Content="Datei öffnen" Margin="0,0,6,6" />
                                    <Button x:Name="DocFromTemplateBtn" Content="Neu aus dieser Vorlage" Margin="0,0,6,6" />
                                    <Button x:Name="DocDeleteBtn" Content="Löschen" Margin="0,0,6,6" />
                                </WrapPanel>
                                <TextBlock Text="Verse in diesem Dokument" FontWeight="SemiBold" />
                                <WrapPanel x:Name="DocVerseChips" />
                                <TextBlock Text="Verknüpft mit" FontWeight="SemiBold" />
                                <WrapPanel x:Name="DocLinkChips" />
                                <TextBlock Text="Erwähnt von" FontWeight="SemiBold" />
                                <WrapPanel x:Name="DocBackChips" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem ToolTip.Tip="KI-Assistent (Claude)">
                    <TabItem.Header><local:Icon Data="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z M19 3v4 M17 5h4 M5 17v4 M3 19h4" /></TabItem.Header>
                    <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,12,12">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="AiNewBtn" DockPanel.Dock="Right" Content="Neues Gespräch" FontSize="12" Padding="10,4" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer x:Name="AiScroll" Grid.Row="1"><StackPanel x:Name="AiMessages" Spacing="10" Margin="0,0,8,0" /></ScrollViewer>
                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                            <TextBlock x:Name="AiStatus" Classes="caption" TextWrapping="Wrap" />
                            <TextBox x:Name="AiInput" AcceptsReturn="True" TextWrapping="Wrap" Height="76" Watermark="Frage oder Auftrag … (Enter sendet, Umschalt+Enter neue Zeile)" />
                            <Button x:Name="AiSendBtn" Content="Senden" Classes="primary" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem ToolTip.Tip="Einstellungen">
                    <TabItem.Header><local:Icon Data="M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4" /></TabItem.Header>
                    <ScrollViewer Margin="16,14,4,12">
                        <StackPanel Spacing="12" Margin="0,0,12,0">

                            <Border Classes="card"><StackPanel Spacing="10">
                                <TextBlock Classes="eyebrow" Text="DARSTELLUNG" />
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" >
                                    <TextBlock Text="Design" VerticalAlignment="Center" />
                                    <Border Classes="pill" Grid.Column="1" HorizontalAlignment="Left">
                                        <ComboBox x:Name="ThemeBox" SelectedIndex="0" Width="180">
                                            <ComboBoxItem Content="System" />
                                            <ComboBoxItem Content="Hell" />
                                            <ComboBoxItem Content="Dunkel" />
                                        </ComboBox>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="Akzentfarbe" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <WrapPanel x:Name="AccentPanel" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                                </Grid>
                                <TextBlock x:Name="FontLabel" Text="Schriftgröße" />
                                <Slider x:Name="FontSlider" Minimum="14" Maximum="40" Value="22" TickFrequency="1" IsSnapToTickEnabled="True" />
                                <TextBlock x:Name="LineLabel" Text="Zeilenabstand" />
                                <Slider x:Name="LineSlider" Minimum="1.2" Maximum="2.4" Value="1.7" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                <TextBlock x:Name="WidthLabel" Text="Textbreite" />
                                <Slider x:Name="WidthSlider" Minimum="480" Maximum="1100" Value="760" TickFrequency="20" IsSnapToTickEnabled="True" />
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" >
                                    <TextBlock Text="Schriftart" VerticalAlignment="Center" />
                                    <Border Classes="pill" Grid.Column="1" HorizontalAlignment="Left"><ComboBox x:Name="FontBox" Width="180" /></Border>
                                    <TextBlock Grid.Row="1" Text="Versnummern" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Border Classes="pill" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <ComboBox x:Name="VerseNumberBox" Width="180" SelectedIndex="0">
                                            <ComboBoxItem Content="Klein, hochgestellt" />
                                            <ComboBoxItem Content="Normal im Text" />
                                            <ComboBoxItem Content="Ausblenden" />
                                        </ComboBox>
                                    </Border>
                                </Grid>
                                <CheckBox x:Name="JesusRedCheck" Content="Worte Jesu farbig hervorheben" />
                                <CheckBox x:Name="JustifyCheck" Content="Blocksatz" />
                                <CheckBox x:Name="HeadingCheck" Content="Großes Kapitel-Kopfstück (sonst schlicht)" />
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="LESEN UND VERHALTEN" />
                                <CheckBox x:Name="StartHomeCheck" Content="Beim Start die Startseite zeigen" />
                                <CheckBox x:Name="AutoReadCheck" Content="Kapitel beim Weiterblättern (▶) als gelesen markieren" />
                                <CheckBox x:Name="ScrollReadCheck" Content="Kapitel als gelesen markieren, wenn ich bis zum Ende gescrollt habe" />
                                <CheckBox x:Name="AutoTagCheck" Content="Beim Speichern den Buchnamen als Tag vergeben" />
                                <TextBlock Text="Standard-Markierfarbe" Margin="0,4,0,0" />
                                <WrapPanel x:Name="DefaultColorPanel" />
                                <TextBlock x:Name="SpeakLabel" Text="Vorlesen: Geschwindigkeit" Margin="0,4,0,0" />
                                <Slider x:Name="SpeakSlider" Minimum="-5" Maximum="5" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="ClearHistoryBtn" Content="Suchverlauf löschen" />
                                    <Button x:Name="ResetSettingsBtn" Content="Darstellung zurücksetzen" />
                                </StackPanel>
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="VAULT" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Ein Vault ist wie eine eigene Mappe für ein Studienprojekt: Markierungen, Notizen, Dokumente, Leseliste, Aufgaben und dein Lesefortschritt gehören immer zu genau einem Vault. Du kannst mehrere anlegen (z. B. „Predigt“ und „Privat“) und hier wechseln. Jeder Vault ist eine einzelne Datei." />
                                <Border Classes="pill" HorizontalAlignment="Left"><ComboBox x:Name="VaultBox" Width="220" /></Border>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBox x:Name="NewVaultBox" Width="170" Watermark="Name des neuen Vaults" />
                                    <Button x:Name="NewVaultBtn" Content="Anlegen" />
                                </StackPanel>
                                <TextBlock x:Name="VaultInfo" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="KI UND MCP" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Das KI-Fenster nutzt deine lokal installierte Claude-Code-App mit deiner Anmeldung: kein API-Schlüssel, keine API-Kosten durch das Programm. Claude sieht nur die Bibel-Werkzeuge dieses Programms." />
                                <TextBlock x:Name="AiCliInfo" Classes="caption" TextWrapping="Wrap" />
                                <TextBlock Text="Hintergrund für Claude (frei änderbar)" />
                                <TextBox x:Name="AiContextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                                <TextBox x:Name="AiModelBox" Watermark="Modell (leer = deine Standardeinstellung), z. B. sonnet" />
                                <TextBlock Text="MCP-Server für andere Programme (z. B. Claude Code)" />
                                <TextBox x:Name="McpCommandBox" IsReadOnly="True" TextWrapping="Wrap" />
                                <Button x:Name="McpCopyBtn" Content="Befehl kopieren" HorizontalAlignment="Left" />
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="SICHERUNG" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Exportiert den aktiven Vault (Markierungen, Ordner, Tags, Notizen, Dokumente, Leseliste, Aufgaben, Lesefortschritt) und deine Einstellungen als eine ZIP-Datei. Beim Import entsteht ein neuer Vault." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ExportBtn" Content="Exportieren …" />
                                    <Button x:Name="ImportBtn" Content="Importieren …" />
                                </StackPanel>
                                <TextBlock x:Name="BackupInfo" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="EIGENE ÜBERSETZUNG IMPORTIEREN" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Für Bibeltexte, die du rechtmäßig besitzt und die nicht frei verfügbar sind (z. B. die Elberfelder Edition CSV). Unterstützt: e-Sword-Module (.bblx), Zefania-XML und die Offline-HTML der CSV-Bibel (mit Strong-Nummern und Fußnoten). Der Text bleibt nur auf diesem Rechner und dient deiner privaten Nutzung; gib ihn nicht weiter und lege ihn nicht in ein öffentliches Repository." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="ImportLangBox" Width="70" Text="de" Watermark="Sprache" ToolTip.Tip="Sprachcode der Datei, z. B. de oder en (bei der CSV-Datei automatisch Deutsch)" />
                                    <Button x:Name="ImportBibleBtn" Content="Datei wählen …" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="pill"><ComboBox x:Name="LocalBibleBox" Width="200" PlaceholderText="Importierte Übersetzungen" /></Border>
                                    <Button x:Name="RemoveBibleBtn" Content="Entfernen" />
                                </StackPanel>
                                <TextBlock x:Name="ImportBibleInfo" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="OFFLINE" />
                                <TextBlock x:Name="OfflineInfo" Classes="caption" TextWrapping="Wrap" />
                                <Button x:Name="OfflineBtn" Content="Gewählte Übersetzung offline verfügbar machen" HorizontalAlignment="Left" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Es werden nur Texte geladen, die die Quelle zur freien Nutzung anbietet; Lizenz und Namensnennung stehen unten in der Fußzeile. Die Daten liegen lokal und gehören dir." />
                            </StackPanel></Border>

                            <Border Classes="card"><StackPanel Spacing="4">
                                <TextBlock Classes="eyebrow" Text="TASTENKÜRZEL" />
                                <TextBlock TextWrapping="Wrap" LineHeight="22" Text="Strg+K  Gehe zu Stelle oder suchen&#10;Strg+F  Suche öffnen&#10;Alt+←  Zurück · Alt+Pos1  Startseite&#10;Strg+← / →  Voriges / nächstes Kapitel&#10;Strg+R  Kapitel als gelesen markieren&#10;Strg+D  Vers speichern · Strg+Umschalt+C  Vers mit Stelle kopieren&#10;Strg++ / Strg+−  Schrift größer / kleiner · Strg+0  Standard&#10;Strg+B  Seitenleiste · Strg+T  Design wechseln&#10;F11  Fokus-Modus (nur Text)" />
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem ToolTip.Tip="Hilfe">
                    <TabItem.Header><local:Icon Data="M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0z M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3 M12 17h.01" /></TabItem.Header>
                    <ScrollViewer Margin="16,14,4,12">
                        <StackPanel Spacing="10" Margin="0,0,12,0">
                            <TextBlock FontWeight="SemiBold" Text="Lesen und Navigieren" />
                            <TextBlock TextWrapping="Wrap" Text="Haus-Symbol: Startseite mit allen Büchern. Pfeil links: zurück zur vorherigen Stelle. Buch, Kapitel und Übersetzung wählst du oben; ◀ ▶ blättert Kapitel." />
                            <TextBlock FontWeight="SemiBold" Text="Gelesen" />
                            <TextBlock TextWrapping="Wrap" Text="Das Häkchen oben markiert das Kapitel als gelesen. Auf der Startseite zeigt ein Balken den Fortschritt je Buch. Im Kapitelraster: Rechtsklick oder Strg+Klick markiert einzelne Kapitel, die Knöpfe markieren ein ganzes Buch." />
                            <TextBlock FontWeight="SemiBold" Text="Verse" />
                            <TextBlock TextWrapping="Wrap" Text="Vers anklicken: Notiz, Lesezeichen und Querverweise beziehen sich darauf. Der Knopf „Parallel“ zeigt bis zu drei weitere Übersetzungen versgenau daneben." />
                            <TextBlock FontWeight="SemiBold" Text="Wortstudie" />
                            <TextBlock TextWrapping="Wrap" Text="Den Schalter „Wortstudie“ einschalten (nur Übersetzungen mit Strong-Nummern, z. B. KJV). Unterstrichene Wörter anklicken: Grundtextwort, Bedeutung, „Alle Vorkommen“ in der Konkordanz." />
                            <TextBlock FontWeight="SemiBold" Text="Suche" />
                            <TextBlock TextWrapping="Wrap" Text="Wörter, „Wendungen“, Gnade / Wahrheit (ODER), Gnade -Wahrheit (ausschließen), Klammern, L=Grundform, Platzhalter *, Strong-Nummern (G3056, H8392=Arche), Bibelstellen (Joh 3,16; Mt 14,13-21) und griechische/hebräische Wörter. Der Knopf „Suchhilfe“ in der Suche zeigt alle Beispiele zum Anklicken; die Buchkürzel unter dem Ergebnis grenzen die Treffer ein." />
                            <TextBlock FontWeight="SemiBold" Text="Schnell navigieren" />
                            <TextBlock TextWrapping="Wrap" Text="Strg+K öffnet „Gehe zu“: „Röm 8,28“ springt dorthin, ein Buchname öffnet das Buch, alles andere startet die Suche. Alle Tastenkürzel stehen unter Einstellungen." />
                            <TextBlock FontWeight="SemiBold" Text="Offline" />
                            <TextBlock TextWrapping="Wrap" Text="Einstellungen → „Offline verfügbar machen“ lädt eine ganze Übersetzung. Bereits gelesene Kapitel sind automatisch offline lesbar." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem ToolTip.Tip="Info: Maße, Gewichte, Abkürzungen">
                    <TabItem.Header><local:Icon Data="M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0z M12 16v-4 M12 8h.01" /></TabItem.Header>
                    <ScrollViewer Margin="16,14,4,12">
                        <StackPanel Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Richtwerte (ca.); die Angaben schwanken je nach Zeit und Region." />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Längenmaße" />
                            <TextBlock TextWrapping="Wrap" Text="Fingerbreit ≈ 1,9 cm · Handbreit ≈ 7,5 cm · Spanne ≈ 22 cm · Elle ≈ 45 cm · Rute ≈ 2,7 m · Stadion ≈ 185 m · Sabbatweg ≈ 1 km (2000 Ellen)" />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Gewichte und Geld" />
                            <TextBlock TextWrapping="Wrap" Text="Gera ≈ 0,57 g · Beka ≈ 5,7 g · Schekel ≈ 11,4 g · Mine ≈ 570 g (50 Schekel) · Talent ≈ 34 kg (3000 Schekel) · Denar = ein Tageslohn · Groschen/Quadrans = kleine Kupfermünze" />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Hohlmaße" />
                            <TextBlock TextWrapping="Wrap" Text="Log ≈ 0,3 l · Hin ≈ 3,7 l · Epha/Bat ≈ 22 l · Homer/Kor ≈ 220 l · Gomer/Omer ≈ 2,2 l" />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Zeit" />
                            <TextBlock TextWrapping="Wrap" Text="Der Tag beginnt am Abend. Nachtwachen: drei bis vier Abschnitte. Dritte Stunde ≈ 9 Uhr, sechste ≈ 12 Uhr, neunte ≈ 15 Uhr." />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Abkürzungen im Programm" />
                            <TextBlock TextWrapping="Wrap" Text="G… = Strong-Nummer Griechisch, H… = Strong-Nummer Hebräisch · KJV/KJAV = King James Version · AT/NT = Altes/Neues Testament · CC BY(-SA) = Creative-Commons-Lizenz mit Namensnennung (und Weitergabe unter gleichen Bedingungen)" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            </DockPanel>
        </Border>
        <Border x:Name="SideSplitter" DockPanel.Dock="Right" Width="8" Background="Transparent" Cursor="SizeWestEast" />

        <!-- Reader -->
        <Grid>
            <Grid x:Name="ReaderHost" ColumnDefinitions="*,Auto">
                <ScrollViewer x:Name="ReaderScroll">
                    <StackPanel x:Name="ReaderPanel" Margin="0,36,0,80" HorizontalAlignment="Center" Spacing="2" />
                </ScrollViewer>
                <local:ThreadGraph x:Name="ThreadPane" Grid.Column="1" IsVisible="False" Margin="0,0,8,0" />
            </Grid>
            <local:HomeView x:Name="Home" IsVisible="False" Background="{DynamicResource BsBackground}" />
            <local:GraphView x:Name="GraphPane" IsVisible="False" Background="{DynamicResource BsBackground}" />
            <local:MapView x:Name="MapPane" IsVisible="False" Background="{DynamicResource BsBackground}" />
            <local:KnowledgeView x:Name="KnowledgePane" IsVisible="False" Background="{DynamicResource BsBackground}" />
        </Grid>
    </DockPanel>
</Window>
