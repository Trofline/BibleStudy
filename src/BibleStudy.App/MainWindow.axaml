<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BibleStudy.App"
        x:Class="BibleStudy.App.MainWindow"
        Title="BibleStudy" Width="1280" Height="800" MinWidth="1180" MinHeight="560"
        Background="{DynamicResource BsBackground}" Foreground="{DynamicResource BsText}">
    <Window.Resources>
        <DataTemplate x:Key="EntryTpl" x:DataType="local:Entry">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" IsVisible="{Binding HasColor}" Background="{Binding ColorBrush}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource BsAccent}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource BsSurface}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Margin="0,0,18,0" Background="{DynamicResource BsAccent}">
                    <local:Icon Data="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"
                                IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource BsSurface}" />
                </Border>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Classes="tool" ToolTip.Tip="Zurück zur vorherigen Stelle">
                        <local:Icon Data="M19 12H5 M12 19l-7-7 7-7" />
                    </Button>
                    <Button x:Name="HomeBtn" Classes="tool" ToolTip.Tip="Startseite: alle Bücher und Kapitel">
                        <local:Icon Data="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="ReadBtn" Classes="tool" ToolTip.Tip="Dieses Kapitel als gelesen markieren">
                        <local:Icon Data="M20 6L9 17l-5-5" />
                    </ToggleButton>
                    <Button x:Name="ViewBtn" Classes="tool" ToolTip.Tip="Ansicht: Querverweise im Text, Graph neben dem Text">
                        <local:Icon Data="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0z" />
                    </Button>
                    <Button x:Name="GraphBtn" Classes="tool" ToolTip.Tip="Querverweis-Graph (Netzwerk und Bogen)">
                        <local:Icon Data="M5 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M15 5a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M15 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0z M8.7 11l6.6-4.9 M8.7 13l6.6 4.9" />
                    </Button>
                    <Button x:Name="ParallelBtn" Classes="tool" ToolTip.Tip="Weitere Übersetzung als Spalte daneben (max. 3)">
                        <local:Icon Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M12 3v18" />
                    </Button>
                    <ToggleButton x:Name="StudyBtn" Classes="tool" ToolTip.Tip="Wortstudie: Wörter mit Strong-Nummer antippen">
                        <local:Icon Data="m5 8 6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 m22 22-5-10-5 10 M14 18h6" />
                    </ToggleButton>
                    <Button x:Name="MarkBtn" Classes="tool" ToolTip.Tip="Markieren: markierten Text oder Vers einfärben">
                        <local:Icon Data="m9 11-6 6v3h9l3-3 M22 12l-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4" />
                    </Button>
                    <Button x:Name="BookmarkBtn" Classes="tool" ToolTip.Tip="Ganzen Vers speichern / entfernen (Standardfarbe)">
                        <local:Icon Data="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                    </Button>
                    <Rectangle Classes="sep" Margin="8,0" />
                    <Button x:Name="FontMinusBtn" Classes="tool" Content="A−" FontSize="13" FontWeight="SemiBold" ToolTip.Tip="Schrift kleiner" />
                    <Button x:Name="FontPlusBtn" Classes="tool" Content="A+" FontSize="15" FontWeight="SemiBold" ToolTip.Tip="Schrift größer" />
                    <Button x:Name="ThemeBtn" Classes="tool" ToolTip.Tip="Hell / Dunkel / System wechseln">
                        <local:Icon Data="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="pill">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="LanguageBox" Width="128" PlaceholderText="Sprache" />
                            <Rectangle Classes="sep" />
                            <ComboBox x:Name="TranslationBox" Width="250" PlaceholderText="Übersetzung" />
                        </StackPanel>
                    </Border>
                    <Border Classes="pill">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="BookBox" Width="150" PlaceholderText="Buch" />
                            <Rectangle Classes="sep" />
                            <Button x:Name="PrevBtn" Classes="tool" Width="32" Height="32" ToolTip.Tip="Voriges Kapitel">
                                <local:Icon Data="M15 18l-6-6 6-6" />
                            </Button>
                            <NumericUpDown x:Name="ChapterBox" Width="52" Minimum="1" Value="1" FormatString="0" ShowButtonSpinner="False"
                                           Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" MinHeight="32" />
                            <Button x:Name="NextBtn" Classes="tool" Width="32" Height="32" ToolTip.Tip="Nächstes Kapitel">
                                <local:Icon Data="M9 18l6-6-6-6" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Extra translation columns -->
        <WrapPanel x:Name="ParallelBar" DockPanel.Dock="Top" IsVisible="False" Background="{DynamicResource BsSurface}" />

        <!-- Footer: license information of the shown translations -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" Background="{DynamicResource BsSurface}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Classes="caption" TextWrapping="Wrap" />
        </Border>

        <!-- Side panel with icon rail -->
        <Border DockPanel.Dock="Right" Width="430" Background="{DynamicResource BsSurface}"
                BorderBrush="{DynamicResource BsBorder}" BorderThickness="1,0,0,0">
            <TabControl x:Name="SideTabs" TabStripPlacement="Left">
                <TabItem ToolTip.Tip="Suche">
                    <TabItem.Header><local:Icon Data="M3 11a8 8 0 1 0 16 0a8 8 0 1 0-16 0z M21 21l-4.3-4.3" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Classes="h2" Text="Suche" />
                            <TextBox x:Name="SearchBox" Watermark="Suchbegriffe, Enter zum Suchen" />
                            <TextBlock x:Name="SearchInfo" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox x:Name="SearchList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Sammlung: Markierungen, Ordner, Tags">
                    <TabItem.Header><local:Icon Data="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 7.9 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2z" /></TabItem.Header>
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,14,12,12">
                        <TextBlock Classes="h2" Text="Sammlung" Margin="0,0,0,8" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" Margin="0,0,0,6">
                            <Border Classes="pill" Margin="0,0,6,0"><ComboBox x:Name="FolderFilterBox" HorizontalAlignment="Stretch" /></Border>
                            <Border Classes="pill" Grid.Column="1"><ComboBox x:Name="TagFilterBox" HorizontalAlignment="Stretch" /></Border>
                            <Button x:Name="DeleteFolderBtn" Grid.Column="2" Classes="tool" Width="32" Height="32" IsVisible="False" ToolTip.Tip="Gewählten Ordner löschen (Markierungen bleiben erhalten)">
                                <local:Icon Data="M18 6L6 18 M6 6l12 12" IconSize="16" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="NewFolderBox" Grid.Row="2" Watermark="Neuen Ordner anlegen (Enter)" Margin="0,0,0,8" />
                        <ListBox x:Name="MarksList" Grid.Row="3" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <Border x:Name="MarkEditor" Grid.Row="4" IsVisible="False" Margin="0,8,0,0" Padding="10" CornerRadius="12" Background="{DynamicResource BsSurface2}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="MarkEditTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <WrapPanel x:Name="EditSwatches" />
                                <TextBox x:Name="MarkNoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" Watermark="Notiz zu dieser Markierung" />
                                <TextBox x:Name="MarkTagsBox" Watermark="Tags, mit Komma getrennt" />
                                <Border Classes="pill"><ComboBox x:Name="MarkFolderBox" HorizontalAlignment="Stretch" /></Border>
                                <WrapPanel>
                                    <Button x:Name="MarkSaveBtn" Content="Speichern" Classes="accent" Margin="0,0,6,0" />
                                    <Button x:Name="MarkQueueBtn" Content="In Warteschlange" Margin="0,0,6,0" />
                                    <Button x:Name="MarkDeleteBtn" Content="Löschen" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem ToolTip.Tip="Notizen">
                    <TabItem.Header><local:Icon Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Classes="h2" Text="Notizen" />
                            <TextBlock x:Name="NoteTarget" Classes="caption" Text="Vers anklicken, um eine Notiz zu schreiben" TextWrapping="Wrap" />
                            <TextBox x:Name="NoteEditor" AcceptsReturn="True" TextWrapping="Wrap" Height="120" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="NoteSaveBtn" Content="Speichern" Classes="accent" />
                                <Button x:Name="NoteDeleteBtn" Content="Löschen" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="NoteList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Wortstudie">
                    <TabItem.Header><local:Icon Data="m5 8 6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 m22 22-5-10-5 10 M14 18h6" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Wortstudie" Margin="0,0,0,8" />
                        <ScrollViewer><StackPanel x:Name="StudyPanel" Spacing="10" Margin="0,0,8,0" /></ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Querverweise">
                    <TabItem.Header><local:Icon Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Classes="h2" Text="Querverweise" />
                            <Button x:Name="XrefQueueBtn" Content="Alle in die Warteschlange" HorizontalAlignment="Left" ToolTip.Tip="Die gezeigten Querverweise nacheinander abarbeiten" />
                            <TextBlock x:Name="XrefTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="Vers anklicken, um Querverweise zu sehen" />
                            <TextBlock Classes="caption" Text="Quelle: OpenBible.info, CC BY 4.0" />
                        </StackPanel>
                        <ListBox x:Name="XrefList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Konkordanz">
                    <TabItem.Header><local:Icon Data="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Classes="h2" Text="Konkordanz" />
                            <TextBlock x:Name="ConcTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="In der Wortstudie „Alle Vorkommen“ wählen" />
                            <TextBlock x:Name="ConcInfo" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox x:Name="ConcList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="Warteschlange">
                    <TabItem.Header><local:Icon Data="M10 12h11 M10 18h11 M10 6h11 M4 10h2 M4 6h1v4 M6 18H4c0-1 2-2 2-3s-1-1.5-2-1" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <TextBlock Classes="h2" Text="Warteschlange" />
                            <TextBlock x:Name="QueueInfo" Classes="caption" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button x:Name="QueueNextBtn" Content="Nächster ▶" Classes="accent" Margin="0,0,6,6" ToolTip.Tip="Springt zum ersten Eintrag und nimmt ihn aus der Warteschlange" />
                                <Button x:Name="QueueAddBtn" Content="Vers hinzufügen" Margin="0,0,6,6" />
                                <Button x:Name="QueueRemoveBtn" Content="Entfernen" Margin="0,0,6,6" />
                                <Button x:Name="QueueClearBtn" Content="Leeren" Margin="0,0,6,6" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="QueueList" ItemTemplate="{StaticResource EntryTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="To-Do-Liste">
                    <TabItem.Header><local:Icon Data="M21 10.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.5 m9 11 3 3L22 4" /></TabItem.Header>
                    <DockPanel Margin="16,14,12,12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Classes="h2" Text="To-Do" />
                            <TextBox x:Name="TodoBox" Watermark="Neue Aufgabe, Enter zum Hinzufügen" />
                            <CheckBox x:Name="TodoVerseCheck" Content="Angeklickten Vers anhängen" />
                        </StackPanel>
                        <ScrollViewer><StackPanel x:Name="TodoPanel" Spacing="4" Margin="0,0,8,0" /></ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem ToolTip.Tip="KI-Assistent (Claude)">
                    <TabItem.Header><local:Icon Data="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z M19 3v4 M17 5h4 M5 17v4 M3 19h4" /></TabItem.Header>
                    <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,12,12">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="AiNewBtn" DockPanel.Dock="Right" Content="Neues Gespräch" FontSize="12" Padding="10,4" VerticalAlignment="Center" />
                            <TextBlock Classes="h2" Text="KI-Assistent" />
                        </DockPanel>
                        <ScrollViewer x:Name="AiScroll" Grid.Row="1"><StackPanel x:Name="AiMessages" Spacing="10" Margin="0,0,8,0" /></ScrollViewer>
                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                            <TextBlock x:Name="AiStatus" Classes="caption" TextWrapping="Wrap" />
                            <TextBox x:Name="AiInput" AcceptsReturn="True" TextWrapping="Wrap" Height="76" Watermark="Frage oder Auftrag … (Enter sendet, Umschalt+Enter neue Zeile)" />
                            <Button x:Name="AiSendBtn" Content="Senden" Classes="accent" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem ToolTip.Tip="Einstellungen">
                    <TabItem.Header><local:Icon Data="M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4" /></TabItem.Header>
                    <ScrollViewer Margin="16,14,4,12">
                        <StackPanel Spacing="12" Margin="0,0,12,0">
                            <TextBlock Classes="h2" Text="Einstellungen" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Design" FontWeight="SemiBold" />
                                <Border Classes="pill" HorizontalAlignment="Left">
                                    <ComboBox x:Name="ThemeBox" SelectedIndex="0" Width="200">
                                        <ComboBoxItem Content="System" />
                                        <ComboBoxItem Content="Hell" />
                                        <ComboBoxItem Content="Dunkel" />
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="FontLabel" Text="Schriftgröße" FontWeight="SemiBold" />
                                <Slider x:Name="FontSlider" Minimum="14" Maximum="36" Value="22" TickFrequency="1" IsSnapToTickEnabled="True" />
                            </StackPanel>
                            <CheckBox x:Name="StartHomeCheck" Content="Beim Start die Startseite zeigen" />
                            <CheckBox x:Name="AutoReadCheck" Content="Kapitel beim Weiterblättern (▶) als gelesen markieren" />
                            <Border Height="1" Background="{DynamicResource BsBorder}" />
                            <TextBlock Text="Vault" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Ein Vault enthält deine persönlichen Daten: Markierungen, Ordner, Tags, Notizen, Warteschlange, To-Dos, Lesefortschritt. Jeder Vault ist eine einzelne Datei." />
                            <Border Classes="pill" HorizontalAlignment="Left"><ComboBox x:Name="VaultBox" Width="220" /></Border>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox x:Name="NewVaultBox" Width="170" Watermark="Name des neuen Vaults" />
                                <Button x:Name="NewVaultBtn" Content="Anlegen" />
                            </StackPanel>
                            <TextBlock x:Name="VaultInfo" Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Text="Standard-Markierfarbe" FontWeight="SemiBold" />
                            <WrapPanel x:Name="DefaultColorPanel" />
                            <CheckBox x:Name="AutoTagCheck" Content="Beim Speichern den Buchnamen als Tag vergeben" />
                            <Border Height="1" Background="{DynamicResource BsBorder}" />
                            <TextBlock Text="KI und MCP" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Das KI-Fenster nutzt deine lokal installierte Claude-Code-App mit deiner Anmeldung: kein API-Schlüssel, keine API-Kosten durch das Programm. Claude sieht nur die Bibel-Werkzeuge dieses Programms." />
                            <TextBlock x:Name="AiCliInfo" Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Text="Hintergrund für Claude (frei änderbar)" />
                            <TextBox x:Name="AiContextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                            <TextBox x:Name="AiModelBox" Watermark="Modell (leer = deine Standardeinstellung), z. B. sonnet" />
                            <TextBlock Text="MCP-Server für andere Programme (z. B. Claude Code)" />
                            <TextBox x:Name="McpCommandBox" IsReadOnly="True" TextWrapping="Wrap" />
                            <Button x:Name="McpCopyBtn" Content="Befehl kopieren" HorizontalAlignment="Left" />
                            <Border Height="1" Background="{DynamicResource BsBorder}" />
                            <TextBlock Text="Offline" FontWeight="SemiBold" />
                            <TextBlock x:Name="OfflineInfo" Classes="caption" TextWrapping="Wrap" />
                            <Button x:Name="OfflineBtn" Content="Gewählte Übersetzung offline verfügbar machen" HorizontalAlignment="Left" />
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Es werden nur Texte geladen, die die Quelle zur freien Nutzung anbietet; Lizenz und Namensnennung stehen unten in der Fußzeile. Die Daten liegen lokal und gehören dir." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem ToolTip.Tip="Hilfe">
                    <TabItem.Header><local:Icon Data="M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0z M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3 M12 17h.01" /></TabItem.Header>
                    <ScrollViewer Margin="16,14,4,12">
                        <StackPanel Spacing="10" Margin="0,0,12,0">
                            <TextBlock Classes="h2" Text="Hilfe" />
                            <TextBlock FontWeight="SemiBold" Text="Lesen und Navigieren" />
                            <TextBlock TextWrapping="Wrap" Text="Haus-Symbol: Startseite mit allen Büchern. Pfeil links: zurück zur vorherigen Stelle. Buch, Kapitel und Übersetzung wählst du oben; ◀ ▶ blättert Kapitel." />
                            <TextBlock FontWeight="SemiBold" Text="Gelesen" />
                            <TextBlock TextWrapping="Wrap" Text="Das Häkchen oben markiert das Kapitel als gelesen. Auf der Startseite zeigt ein Balken den Fortschritt je Buch. Im Kapitelraster: Rechtsklick oder Strg+Klick markiert einzelne Kapitel, die Knöpfe markieren ein ganzes Buch." />
                            <TextBlock FontWeight="SemiBold" Text="Verse" />
                            <TextBlock TextWrapping="Wrap" Text="Vers anklicken: Notiz, Lesezeichen und Querverweise beziehen sich darauf. Der Knopf „Parallel“ zeigt bis zu drei weitere Übersetzungen versgenau daneben." />
                            <TextBlock FontWeight="SemiBold" Text="Wortstudie" />
                            <TextBlock TextWrapping="Wrap" Text="Den Schalter „Wortstudie“ einschalten (nur Übersetzungen mit Strong-Nummern, z. B. KJV). Unterstrichene Wörter anklicken: Grundtextwort, Bedeutung, „Alle Vorkommen“ in der Konkordanz." />
                            <TextBlock FontWeight="SemiBold" Text="Offline" />
                            <TextBlock TextWrapping="Wrap" Text="Einstellungen → „Offline verfügbar machen“ lädt eine ganze Übersetzung. Bereits gelesene Kapitel sind automatisch offline lesbar." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem ToolTip.Tip="Info: Maße, Gewichte, Abkürzungen">
                    <TabItem.Header><local:Icon Data="M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0z M12 16v-4 M12 8h.01" /></TabItem.Header>
                    <ScrollViewer Margin="16,14,4,12">
                        <StackPanel Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="h2" Text="Info" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Richtwerte (ca.); die Angaben schwanken je nach Zeit und Region." />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Längenmaße" />
                            <TextBlock TextWrapping="Wrap" Text="Fingerbreit ≈ 1,9 cm · Handbreit ≈ 7,5 cm · Spanne ≈ 22 cm · Elle ≈ 45 cm · Rute ≈ 2,7 m · Stadion ≈ 185 m · Sabbatweg ≈ 1 km (2000 Ellen)" />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Gewichte und Geld" />
                            <TextBlock TextWrapping="Wrap" Text="Gera ≈ 0,57 g · Beka ≈ 5,7 g · Schekel ≈ 11,4 g · Mine ≈ 570 g (50 Schekel) · Talent ≈ 34 kg (3000 Schekel) · Denar = ein Tageslohn · Groschen/Quadrans = kleine Kupfermünze" />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Hohlmaße" />
                            <TextBlock TextWrapping="Wrap" Text="Log ≈ 0,3 l · Hin ≈ 3,7 l · Epha/Bat ≈ 22 l · Homer/Kor ≈ 220 l · Gomer/Omer ≈ 2,2 l" />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Zeit" />
                            <TextBlock TextWrapping="Wrap" Text="Der Tag beginnt am Abend. Nachtwachen: drei bis vier Abschnitte. Dritte Stunde ≈ 9 Uhr, sechste ≈ 12 Uhr, neunte ≈ 15 Uhr." />
                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Abkürzungen im Programm" />
                            <TextBlock TextWrapping="Wrap" Text="G… = Strong-Nummer Griechisch, H… = Strong-Nummer Hebräisch · KJV/KJAV = King James Version · AT/NT = Altes/Neues Testament · CC BY(-SA) = Creative-Commons-Lizenz mit Namensnennung (und Weitergabe unter gleichen Bedingungen)" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Reader -->
        <Grid>
            <ScrollViewer x:Name="ReaderScroll">
                <Grid x:Name="ReaderHost" ColumnDefinitions="*,Auto">
                    <StackPanel x:Name="ReaderPanel" Margin="0,36,0,80" HorizontalAlignment="Center" Spacing="2" />
                    <local:ThreadGraph x:Name="ThreadPane" Grid.Column="1" IsVisible="False" Margin="0,36,16,80" />
                </Grid>
            </ScrollViewer>
            <local:HomeView x:Name="Home" IsVisible="False" Background="{DynamicResource BsBackground}" />
            <local:GraphView x:Name="GraphPane" IsVisible="False" Background="{DynamicResource BsBackground}" />
        </Grid>
    </DockPanel>
</Window>
