<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <Using Include="BibleStudy.Core.Loc" Static="true" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI languages: flat JSON files, German source text -> translation (see Loc.cs) -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="lang/%(Filename)%(Extension)" />
    <!-- copy of the translation list with licenses: used when the server fails (new installations) -->
    <EmbeddedResource Include="Data\available_translations.json" LogicalName="data/available_translations.json" />
  </ItemGroup>

</Project>
