<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_verse_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_verse_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"
            android:text="BibleStudy" />
        <TextView
            android:id="@+id/widget_verse_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.1"
            android:ellipsize="end"
            android:textColor="@color/widget_text" />
        <TextView
            android:id="@+id/widget_verse_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <!-- a plain View is not allowed in a widget: the line is an empty frame -->
    <FrameLayout
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:id="@+id/widget_plan_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_plan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text" />
        <TextView
            android:id="@+id/widget_plan_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_muted" />
    </LinearLayout>
</LinearLayout>
