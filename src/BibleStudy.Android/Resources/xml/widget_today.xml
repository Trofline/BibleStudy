<?xml version="1.0" encoding="utf-8"?>
<!-- the "Today" widget: verse of the day and today's reading; redrawn when the app goes to the background and once an hour (the verse changes at midnight) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:description="@string/widget_today_description"
    android:widgetCategory="home_screen" />
