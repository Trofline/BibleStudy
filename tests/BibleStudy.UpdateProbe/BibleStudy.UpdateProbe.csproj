<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same program is built against the last published version ("seed") and against this one ("verify"). See run-update-probe.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CoreProject Condition="'$(CoreProject)' == ''">..\..\src\BibleStudy.Core\BibleStudy.Core.csproj</CoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProject)" />
  </ItemGroup>
</Project>
